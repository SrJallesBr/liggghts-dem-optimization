###################################Header for General commands#######################################################

atom_style    granular # define partículas granulares
atom_modify   map array	# otimiza mapeamento dos átomos
boundary      f f f # fronteiras fixas nas três direções
units         si # usa unidades SI
communicate   single vel yes # comunica velocidades entre processadores
newton        off # desativa terceira lei para contatos granulares
processors    1 1 1 # 1 MPI rank per independent trial; 12 trials use 12 visible CPUs
# Para rodar o LIGGGHTS:
# mpirun -np 1 liggghts -in in.caracte

###################################System variables##################################################################




variable dt equal 1e-4 # passo de tempo da simulação

# Fórmula para aproximar dt
# dt = 0.2 * (pi * R * sqrt(rho / (Y / (2 * (1 + nu))))) / (0.1631 * nu + 0.8766)
# dt: timestep (s) | R: menor raio (m) | rho: densidade (kg/m3) | Y: Módulo de Young (Pa) | nu: Poisson

###################################Variáveis específicas da simulação################################################

variable natoms equal 4 # número de tipos de materiais


#### Young Modulus ####

variable youngmodulus1 equal 1e8 # módulo de Young do tipo 1
variable youngmodulus2 equal 1e8 # módulo de Young do tipo 2
variable youngmodulus3 equal 1e8 # módulo de Young do tipo 3
variable youngmodulus4 equal 1e8 # módulo de Young do tipo 4


#### Poisson ratio ####

variable poisson1 equal 0.25 # coeficiente de Poisson do tipo 1
variable poisson2 equal 0.3 # coeficiente de Poisson do tipo 2
variable poisson3 equal 0.3 # coeficiente de Poisson do tipo 3
variable poisson4 equal 0.3 # coeficiente de Poisson do tipo 4


#### Coefficient of restitution ####

variable 	CoR11 equal 0.10
variable 	CoR12 equal 0.10
variable 	CoR13 equal 0.30
variable 	CoR14 equal 0.10
variable 	CoR21 equal ${CoR12}
variable 	CoR22 equal 0.1
variable 	CoR23 equal 0.1
variable 	CoR24 equal 0.1
variable 	CoR31 equal ${CoR13}
variable 	CoR32 equal ${CoR23}
variable 	CoR33 equal 0.1
variable 	CoR34 equal 0.1
variable 	CoR41 equal ${CoR14}
variable 	CoR42 equal ${CoR24}
variable 	CoR43 equal ${CoR34}
variable 	CoR44 equal 0.1

#### Sliding friction coefficient ####
#Alterar apenas os valores numéricos (lembre-se que alguns termos são simétricos)#

variable	sf11	index	0.5 #DOE factor; source baseline from uploaded Ang Repouso.zip
variable	sf12	index	0.45 #interação particula-superficie: dados advindos da calibração "parede"  na calibração histórica /
variable	sf13	equal	0.45 #interação particula-particula: dados advindos da calibração "parede"  na calibração histórica / 
variable	sf14	equal	0.0
variable	sf21	equal	${sf12}
variable	sf22	equal	0.0
variable	sf23	equal	0.0
variable	sf24	equal	0.0
variable	sf31	equal	${sf13}
variable	sf32	equal	${sf23}
variable	sf33	equal	0.0
variable	sf34	equal	0.0
variable	sf41	equal	${sf14}
variable	sf42	equal	${sf24}
variable	sf43	equal	${sf34}
variable	sf44	equal	0.0

#### Rolling friction coefficient ####
#Alterar apenas os valores numéricos (lembre-se que alguns termos são simétricos)#

variable	rf11	index	1.0 # prepared LIGGGHTS starting guess; optimized, not Rocky equivalence
variable	rf12	index	1.0 #interação particula-superficie: dados advindos da calibração "parede"
variable	rf13	equal	1.0 #interação particula-superficie: dados advindos da calibração "parede"
variable	rf14	equal	0.0
variable	rf21	equal	${rf12}
variable	rf22	equal	0.0
variable	rf23	equal	0.0
variable	rf24	equal	0.0
variable	rf31	equal	${rf13}
variable	rf32	equal	${rf23}
variable	rf33	equal	0.0
variable	rf34	equal	0.0
variable	rf41	equal	${rf14}
variable	rf42	equal	${rf24}
variable	rf43	equal	${rf34}
variable	rf44	equal	0.0

####cohesivity energy density####	
#Alterar apenas os valores numéricos (lembre-se que alguns termos são simétricos)#
					
variable	CED11	index	1000 #DOE factor; source baseline from uploaded Ang Repouso.zip
variable	CED12	index	0
variable	CED13	equal	0
variable	CED14	equal	0.0			
variable	CED21	equal	${CED12}			
variable	CED22	equal	0.0	
variable	CED23	equal	0.0
variable	CED24	equal	0.0
variable	CED31	equal	${CED13}
variable	CED32	equal	${CED23}
variable	CED33	equal	0.0
variable	CED34	equal	0.0
variable	CED41	equal	${CED14}
variable	CED42	equal	${CED24}				
variable	CED43	equal	${CED34}
variable	CED44	equal	0.0


#### Variáveis para as partículas ####

### SEMPRE COLOCAR DO MENOR RAIO PARA O MAIOR!!!!!

variable radiusnbr equal 0.01 #Tamanho otimizado

variable nradii equal 7

variable radius1 equal 0.250/2
variable radius2 equal 0.275/2
variable radius3 equal 0.325/2
variable radius4 equal 0.375/2
variable radius5 equal 0.425/2
variable radius6 equal 0.475/2
variable radius7 equal 0.525/2

variable frac1 equal 0.930
variable frac2 equal 0.030
variable frac3 equal 0.005
variable frac4 equal 0.005
variable frac5 equal 0.010
variable frac6 equal 0.005
variable frac7 equal 0.015

variable density equal 5280                # Densidade real da particula [kg/m3]

variable nbrratio equal v_radius1/v_radiusnbr # razão das partículas para o valor da NBR


# ANSYS_REPOSE_10S_ONE_SHOT: immutable population, no replenishment.
# Seed variables retained for controller bookkeeping only, not population changes.
variable distribution_seed index 86028121
variable insertion_seed index 86028157
variable simulationtime equal 10.0
# Physical durations [s]; positive durations round UP to whole timesteps.
# If dt does not divide a duration, its excess is less than one dt per stage.
variable output_interval_s equal 0.1
variable dumpstep equal ceil(v_output_interval_s/v_dt)
variable check_interval_s equal 0.05
variable checkstep equal ceil(v_check_interval_s/v_dt)
variable initial_settle_s equal 1.0
variable lift_duration_s equal 5.0
variable post_settle_s equal v_simulationtime-v_initial_settle_s-v_lift_duration_s
variable settle_steps equal ceil(v_initial_settle_s/v_dt)
variable lift_steps equal ceil(v_lift_duration_s/v_dt)
variable post_steps equal ceil(v_post_settle_s/v_dt)
variable desloc_tubo_y equal 0.650*v_nbrratio
variable v_tubo_y equal v_desloc_tubo_y/v_lift_duration_s
read_data initial_particles.data
neighbor 0.02 bin
neigh_modify delay 0 every 1 check yes one 10000 page 100000
pair_style gran model hertz tangential history cohesion sjkr rolling_friction epsd2

pair_coeff * * # aplica modelo a todos os pares

timestep ${dt} # define passo de tempo

fix integrator all nve/sphere # integra movimento das esferas
fix gravi all gravity 9.81 vector 0.0 -1.0 0.0 # aplica gravidade em y negativo

fix ts_check all check/timestep/gran ${checkstep} 0.1 0.1


###################################Definition of Material properties#################################################

fix m1 all property/global youngsModulus peratomtype ${youngmodulus1} ${youngmodulus2} ${youngmodulus3} ${youngmodulus4} # define módulos de Young

fix m2 all property/global poissonsRatio peratomtype ${poisson1} ${poisson2} ${poisson3} ${poisson4} # define coeficientes de Poisson

fix m3 all property/global coefficientRestitution peratomtypepair ${natoms} ${CoR11} ${CoR12} ${CoR13} ${CoR14} ${CoR21} ${CoR22} ${CoR23} ${CoR24} ${CoR31} ${CoR32} ${CoR33} ${CoR34} ${CoR41} ${CoR42} ${CoR43} ${CoR44} # define restituição entre tipos

fix m4 all property/global coefficientFriction peratomtypepair ${natoms} ${sf11} ${sf12} ${sf13} ${sf14} ${sf21} ${sf22} ${sf23} ${sf24} ${sf31} ${sf32} ${sf33} ${sf34} ${sf41} ${sf42} ${sf43} ${sf44} # define atrito deslizante

fix m5 all property/global coefficientRollingFriction peratomtypepair ${natoms} ${rf11} ${rf12} ${rf13} ${rf14} ${rf21} ${rf22} ${rf23} ${rf24} ${rf31} ${rf32} ${rf33} ${rf34} ${rf41} ${rf42} ${rf43} ${rf44} # define atrito de rolamento

fix m6 all property/global cohesionEnergyDensity peratomtypepair ${natoms} ${CED11} ${CED12} ${CED13} ${CED14} ${CED21} ${CED22} ${CED23} ${CED24} ${CED31} ${CED32} ${CED33} ${CED34} ${CED41} ${CED42} ${CED43} ${CED44} # define energia de coesão

fix tubo all mesh/surface file meshes/Container_Cylinder.stl type 4 scale $(0.001*v_nbrratio)
fix base_repouso all mesh/surface file meshes/Upper_Tray.stl type 2 scale $(0.001*v_nbrratio)
fix walls all wall/gran model hertz tangential history cohesion sjkr rolling_friction epsd2 mesh n_meshes 2 meshes tubo base_repouso
shell "mkdir -p post"
thermo ${dumpstep}
thermo_style custom step time atoms ke
thermo_modify flush yes
run ${settle_steps}
fix move_tubo all move/mesh mesh tubo linear 0.0 ${v_tubo_y} 0.0
run ${lift_steps}
unfix move_tubo
run ${post_steps}
write_dump all custom/vtk post/repouso_10s.vtk id type x y z vx vy vz omegax omegay omegaz radius mass
write_restart post/final_10s.restart
